{
  "name": "nodes-engine",
  "description": "An Engine Test Project with a node-based architecture",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/spa",
    "packages/nodes-engine"
  ],
  "scripts": {
    "dev": "yarn workspace @afegmdg/spa run dev",
    "build": "yarn workspace @afegmdg/spa run build",
    "build:engine": "yarn workspace @afegmdg/nodes-engine run build",
    "build:libraries": "yarn workspaces run clean && yarn workspace @afegmdg/nodes-engine run build",
    "errorcheck": "yarn workspaces run errorcheck",
    "lint": "eslint",
    "clean": "yarn workspaces run clean",
    "rr": "rimraf packages/nodes-engine/node_modules packages/spa/node_modules node_modules"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.8.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@types/node": "22.15.12",
    "@webgpu/types": "0.1.69",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.6",
    "rimraf": "6.1.3",
    "rollup": "4.57.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
